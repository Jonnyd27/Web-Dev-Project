@model IEnumerable<Web_Dev_Project.Models.Art>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewBag.Title = "JBLM Edit";
}

<h1>Here is Amelia's Art!</h1>
<a asp-action="Add">Add an entry</a>
<br />

@foreach (var art in Model)
{
    <h2>@Html.DisplayNameFor(m => m.PieceName) @Html.DisplayFor(m => art.PieceName) </h2>
    <h2>@Html.DisplayNameFor(m => m.Description) @Html.DisplayFor(m => art.Description) </h2>
    <br />
    @Html.ActionLink("See Details About this Piece", "ArtInfo", new { id = art.Id })
    <br />
    @Html.ActionLink("Edit this entry", "Edit", new {id= art.Id })
    <br />
    @Html.ActionLink("Delete this entry", "Delete", new { id = art.Id })

}

